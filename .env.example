# 複製成 .env 後修改：cp .env.example .env

# ---- LLM（本地 Ollama）----
LLM_ENABLED=true
OLLAMA_MODEL=qwen3:4b
# 使用主機上的 Ollama 時：OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_TIMEOUT=90
# qwen3 可設 false 關閉思考模式以加快速度；模型不支援 think 參數時請留空
OLLAMA_THINK=

# ---- 偵測 ----
DETECTION_ENABLED=true
DETECTION_INTERVAL=60
CHANGE_LOOKBACK_SECONDS=1800

# ---- 通知 ----
PUBLIC_URL=http://localhost:8000
SLACK_WEBHOOK_URL=
# LINE Messaging API 的 Channel access token（LINE Notify 已停止服務）
LINE_CHANNEL_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=system-tool@example.com
SMTP_TLS=true

GRAFANA_ADMIN_PASSWORD=admin

# ---- 授權 ----
# License Key（也可以放在 data/license.key，或啟動後用 POST /license 設定）
LICENSE_KEY=
# 授權伺服器網址（由供應商提供）
LICENSE_SERVER_URL=https://license.example.com
LICENSE_REFRESH_HOURS=12
# 是否在續驗時回傳使用量統計（服務數、事件數；不含任何 log / metrics 內容）
TELEMETRY_OPT_IN=false
# 設定後，POST /license 等管理 API 需帶 Header：X-Admin-Token
ENGINE_ADMIN_TOKEN=
